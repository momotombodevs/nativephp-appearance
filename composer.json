{
    "name": "momotombo/nativephp-appearance",
    "description": "Application-local light, dark, and system appearance preference for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "keywords": [
        "nativephp",
        "nativephp-mobile",
        "appearance",
        "dark-mode",
        "light-mode",
        "theme"
    ],
    "homepage": "https://github.com/momotombodevs/nativephp-appearance",
    "support": {
        "issues": "https://github.com/momotombodevs/nativephp-appearance/issues",
        "source": "https://github.com/momotombodevs/nativephp-appearance"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Momotombo Dev",
            "email": "hello@momotombo.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "Momotombo\\NativephpAppearance\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momotombo\\NativephpAppearance\\AppearanceServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
